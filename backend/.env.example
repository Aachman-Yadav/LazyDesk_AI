# LazyDesk AI - Backend Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ------------------------------------------------------------------
# Ollama Configuration
# ------------------------------------------------------------------
# The base URL where your Ollama instance is running.
OLLAMA_BASE_URL=http://localhost:11434

# The model to use for inference. Must be pulled first:
#   ollama pull llama3.2
# Other options: gemma2:2b, phi3.5, mistral
OLLAMA_MODEL=llama3.2

# Timeout in seconds for Ollama requests (increase for slower hardware)
OLLAMA_TIMEOUT=120

# ------------------------------------------------------------------
# Backend Server Configuration
# ------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ------------------------------------------------------------------
# Frontend Origin (for CORS)
# ------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------
# Timezone for deadline resolution (IANA timezone name)
# Examples: Asia/Kolkata, America/New_York, Europe/London, UTC
# ------------------------------------------------------------------
LOCAL_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------
# Input Limits
# ------------------------------------------------------------------
MAX_NOTES_LENGTH=5000
MIN_NOTES_LENGTH=10

# ------------------------------------------------------------------
# AI Retry Configuration (max retries on malformed model output)
# ------------------------------------------------------------------
MAX_RETRIES=2

# ------------------------------------------------------------------
# Demo Mode
# ⚠️ Set to true ONLY for demo/review purposes when Ollama is unavailable.
# Demo mode returns clearly labeled sample responses — NOT real AI output.
# NEVER use true in production.
# ------------------------------------------------------------------
DEMO_MODE=false
